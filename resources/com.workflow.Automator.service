[Unit]
Description=Workflow Automator daemon
After=graphical-session.target bluetooth.target power-profiles-daemon.service

[Service]
Type=simple
ExecStart=%h/workflow-automator/venv/bin/python -m src.main --daemon --db %h/.workflow-automator/workflows.db
WorkingDirectory=%h/workflow-automator
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
